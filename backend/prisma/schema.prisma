generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  PENDING
  PAID
  PAYMENT_FAILED
  PREPARING
  READY
  COMPLETED
  CANCELLED

  @@map("order_status")
}

enum Size {
  S
  M
  L

  @@map("size")
}

enum PaymentMethod {
  WALLET
  CARD

  @@map("payment_method")
}

enum PaymentStatus {
  SUCCESS
  FAILED

  @@map("payment_status")
}

enum DiscountType {
  PERCENT
  FIXED

  @@map("discount_type")
}

enum LoyaltyType {
  EARN
  REDEEM
  REVERSAL

  @@map("loyalty_type")
}

// ==================== MODELS ====================

model User {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email         String   @unique @db.VarChar(255)
  passwordHash  String   @db.VarChar(255)
  fullName      String   @db.VarChar(255)
  phone         String?  @db.VarChar(20)
  role          String   @default("CUSTOMER") @db.VarChar(16)
  loyaltyPoints Int      @default(0)
  createdAt     DateTime @default(now()) @db.Timestamptz(6)

  orders              Order[]
  loyaltyTransactions LoyaltyTransaction[]
  ownedVouchers       UserVoucher[]
  performedMovements  IngredientMovement[] @relation("IngredientMovementPerformer")

  avatar         String? @db.VarChar(500)
  favoriteBranch String? @db.VarChar(255)

  @@map("users")
}

model Product {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String  @unique(map: "ux_products_code") @db.VarChar(50)
  name        String  @db.VarChar(255)
  category    String  @db.VarChar(50)
  description String? @db.VarChar(1000)
  imageUrl    String? @db.VarChar(500)
  imageKey    String? @unique(map: "ux_products_image_key") @db.VarChar(100)
  version     Int     @default(0)
  isActive    Boolean @default(true)

  orderItems OrderItem[]
  sizePrices ProductSizePrice[]

  @@map("products")
}

model Topping {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code     String  @unique(map: "ux_toppings_code") @db.VarChar(20)
  name     String  @db.VarChar(255)
  price    Decimal @db.Decimal(12, 2)
  isActive Boolean @default(true)

  orderItemToppings OrderItemTopping[]
  ingredients       ToppingIngredient[]

  @@map("toppings")
}

model ProductSizePrice {
  productId String  @db.Uuid
  size      Size
  price     Decimal @db.Decimal(12, 2)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "product_size_prices_productid_fkey")

  ingredients ProductIngredient[]
  orderItems  OrderItem[]         @relation("OrderItemSize")

  @@id([productId, size], map: "product_size_prices_pkey")
  @@map("product_size_prices")
}

model Coupon {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code          String        @unique @db.VarChar(50)
  discountType  DiscountType
  discountValue Decimal       @db.Decimal(12, 2)
  minOrderValue Decimal       @default(0) @db.Decimal(12, 2)
  maxUses       Int
  usedCount     Int           @default(0)
  isActive      Boolean       @default(true)
  validFrom     DateTime      @db.Timestamptz(6)
  validTo       DateTime      @db.Timestamptz(6)
  ownedVouchers UserVoucher[]

  orders Order[]

  @@map("coupons")
}

model Order {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderCode      Int         @unique @default(autoincrement())
  userId         String      @db.Uuid
  couponId       String?     @db.Uuid
  status         OrderStatus @default(PENDING)
  subtotal       Decimal     @db.Decimal(12, 2)
  discountAmount Decimal     @default(0) @db.Decimal(12, 2)
  pointsUsed     Int         @default(0)
  pointsDiscount Decimal     @default(0) @db.Decimal(12, 2)
  total          Decimal     @db.Decimal(12, 2)
  expiresAt      DateTime    @default(dbgenerated("(now() + '00:20:00'::interval)")) @db.Timestamptz(6)
  createdAt      DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime    @default(now()) @updatedAt @db.Timestamptz(6)

  user                User                 @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  coupon              Coupon?              @relation(fields: [couponId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  orderItems          OrderItem[]
  payments            Payment[]
  loyaltyTransactions LoyaltyTransaction[]
  statusHistory       OrderStatusHistory[]
  usedVouchers        UserVoucher[]        @relation("VoucherUsedOrder")
  ingredientMovements IngredientMovement[]

  idempotencyKey String? @unique(map: "orders_idempotencyKey_key") @db.VarChar(128)
  requestHash    String? @db.VarChar(64)

  @@index([userId, createdAt], map: "idx_orders_user_created")
  @@index([status], map: "idx_orders_status")
  @@index([couponId], map: "idx_orders_coupon")
  @@map("orders")
}

model OrderItem {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId   String  @db.Uuid
  productId String  @db.Uuid
  size      Size
  qty       Int
  basePrice Decimal @db.Decimal(12, 2)
  unitPrice Decimal @db.Decimal(12, 2)
  lineTotal Decimal @db.Decimal(12, 2)

  order     Order              @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  product   Product            @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sizePrice ProductSizePrice   @relation("OrderItemSize", fields: [productId, size], references: [productId, size], onDelete: NoAction, onUpdate: NoAction, map: "fk_order_items_valid_size")
  toppings  OrderItemTopping[]

  @@index([orderId], map: "idx_order_items_order")
  @@index([productId], map: "idx_order_items_product")
  @@map("order_items")
}

model OrderItemTopping {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderItemId String  @db.Uuid
  toppingId   String  @db.Uuid
  price       Decimal @db.Decimal(12, 2)
  servings    Int     @default(1)

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  topping   Topping   @relation(fields: [toppingId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([orderItemId, toppingId], map: "uq_order_item_topping")
  @@index([orderItemId], map: "idx_oit_order_item")
  @@map("order_item_toppings")
}

model Payment {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId        String        @db.Uuid
  idempotencyKey String        @unique @db.VarChar(128)
  amount         Decimal       @db.Decimal(12, 2)
  method         PaymentMethod
  status         PaymentStatus
  providerRef    String?       @db.VarChar(255)
  refundedAmount Decimal       @default(0) @db.Decimal(12, 2)
  refundedAt     DateTime?     @db.Timestamptz(6)
  createdAt      DateTime      @default(now()) @db.Timestamptz(6)

  order Order @relation(fields: [orderId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([orderId], map: "idx_payments_order")
  @@map("payments")
}

model LoyaltyTransaction {
  id        String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String      @db.Uuid
  orderId   String?     @db.Uuid
  points    Int
  type      LoyaltyType
  createdAt DateTime    @default(now()) @db.Timestamptz(6)

  user  User   @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  order Order? @relation(fields: [orderId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([userId], map: "idx_loyalty_user")
  @@map("loyalty_transactions")
}

model OrderStatusHistory {
  id         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId    String       @db.Uuid
  fromStatus OrderStatus?
  toStatus   OrderStatus
  changedAt  DateTime     @default(now()) @db.Timestamptz(6)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([orderId], map: "idx_status_history_order")
  @@map("order_status_history")
}

model UserVoucher {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String    @db.Uuid
  couponId    String    @db.Uuid
  rewardId    String    @db.VarChar(30)
  requestId   String    @unique @db.Uuid
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  usedAt      DateTime? @db.Timestamptz(6)
  usedOrderId String?   @db.Uuid

  user      User   @relation(fields: [userId], references: [id])
  coupon    Coupon @relation(fields: [couponId], references: [id])
  usedOrder Order? @relation("VoucherUsedOrder", fields: [usedOrderId], references: [id])

  @@unique([userId, couponId], map: "uq_user_vouchers_user_coupon")
  @@index([userId], map: "idx_user_vouchers_user")
  @@map("user_vouchers")
}

model Ingredient {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String   @unique @db.VarChar(30)
  name        String   @db.VarChar(255)
  unit        String   @db.VarChar(10)
  stockQty    Decimal  @default(0) @db.Decimal(14, 3)
  minStockQty Decimal  @default(0) @db.Decimal(14, 3)
  version     Int      @default(0)
  isActive    Boolean  @default(true)
  updatedAt   DateTime @default(now()) @db.Timestamptz(6)

  productRecipes ProductIngredient[]
  toppingRecipes ToppingIngredient[]
  movements      IngredientMovement[]

  @@map("ingredients")
}

model ProductIngredient {
  productId    String  @db.Uuid
  size         Size
  ingredientId String  @db.Uuid
  quantity     Decimal @db.Decimal(14, 3)

  productSizePrice ProductSizePrice @relation(fields: [productId, size], references: [productId, size], onDelete: Cascade, onUpdate: NoAction, map: "fk_recipe_product_size")

  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_recipe_ingredient")

  @@id([productId, size, ingredientId])
  @@index([ingredientId], map: "idx_recipe_ingredient")
  @@map("product_ingredients")
}

model ToppingIngredient {
  toppingId    String  @db.Uuid
  ingredientId String  @db.Uuid
  quantity     Decimal @db.Decimal(14, 3)

  topping    Topping    @relation(fields: [toppingId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id])

  @@id([toppingId, ingredientId])
  @@index([ingredientId], map: "idx_topping_recipe_ingredient")
  @@map("topping_ingredients")
}

model IngredientMovement {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ingredientId    String   @db.Uuid
  orderId         String?  @db.Uuid
  performedBy     String?  @db.Uuid
  movementType    String   @db.VarChar(20)
  expectedVersion Int
  quantityChange  Decimal  @db.Decimal(14, 3)
  stockBefore     Decimal  @db.Decimal(14, 3)
  stockAfter      Decimal  @db.Decimal(14, 3)
  note            String?  @db.Text
  createdAt       DateTime @default(now()) @db.Timestamptz(6)

  ingredient Ingredient @relation(fields: [ingredientId], references: [id])
  order      Order?     @relation(fields: [orderId], references: [id], onDelete: Restrict)
  performer  User?      @relation("IngredientMovementPerformer", fields: [performedBy], references: [id])

  @@index([ingredientId, createdAt], map: "idx_movements_ingredient_date")
  @@index([orderId], map: "idx_movements_order")
  @@index([performedBy], map: "idx_movements_performed_by")
  @@map("ingredient_movements")
}

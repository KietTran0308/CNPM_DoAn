generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  PENDING
  PAID
  PAYMENT_FAILED
  PREPARING
  READY
  COMPLETED
  CANCELLED

  @@map("order_status")
}

enum Size {
  S
  M
  L

  @@map("size")
}

enum PaymentMethod {
  WALLET
  CARD

  @@map("payment_method")
}

enum PaymentStatus {
  SUCCESS
  FAILED

  @@map("payment_status")
}

enum DiscountType {
  PERCENT
  FIXED

  @@map("discount_type")
}

enum LoyaltyType {
  EARN
  REDEEM

  @@map("loyalty_type")
}

// ==================== MODELS ====================

model User {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email         String   @unique @db.VarChar(255)
  passwordHash  String   @db.VarChar(255)
  fullName      String   @db.VarChar(255)
  phone         String?  @db.VarChar(20)
  role          String   @default("CUSTOMER") @db.VarChar(16)
  loyaltyPoints Int      @default(0)
  createdAt     DateTime @default(now()) @db.Timestamp(6)

  orders              Order[]
  loyaltyTransactions LoyaltyTransaction[]

  @@map("users")
}

model Product {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String  @unique(map: "ux_products_code") @db.VarChar(50)
  name        String  @db.VarChar(255)
  category    String  @default("coffee_viet") @db.VarChar(50)
  description String? @db.VarChar(1000)
  price       Decimal @db.Decimal(12, 2)
  imageUrl    String? @db.VarChar(500)
  stock       Int     @default(0)
  version     Int     @default(0)
  isActive    Boolean @default(true)

  orderItems OrderItem[]

  @@map("products")
}

model Topping {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code     String  @unique(map: "ux_toppings_code") @db.VarChar(20)
  name     String  @db.VarChar(255)
  price    Decimal @db.Decimal(12, 2)
  isActive Boolean @default(true)

  orderItemToppings OrderItemTopping[]

  @@map("toppings")
}

model SizePrice {
  size       Size    @id
  extraPrice Decimal @db.Decimal(12, 2)

  @@map("size_prices")
}

model Coupon {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code          String       @unique @db.VarChar(50)
  discountType  DiscountType
  discountValue Decimal      @db.Decimal(12, 2)
  minOrderValue Decimal      @default(0) @db.Decimal(12, 2)
  maxUses       Int
  usedCount     Int          @default(0)
  isActive      Boolean      @default(true)
  validFrom     DateTime     @db.Timestamp(6)
  validTo       DateTime     @db.Timestamp(6)

  orders Order[]

  @@map("coupons")
}

model Order {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderCode      Int         @unique @default(autoincrement())
  userId         String      @db.Uuid
  couponId       String?     @db.Uuid
  status         OrderStatus @default(PENDING)
  subtotal       Decimal     @db.Decimal(12, 2)
  discountAmount Decimal     @default(0) @db.Decimal(12, 2)
  pointsUsed     Int         @default(0)
  pointsDiscount Decimal     @default(0) @db.Decimal(12, 2)
  total          Decimal     @db.Decimal(12, 2)
  expiresAt      DateTime    @default(dbgenerated("(now() + '00:20:00'::interval)")) @db.Timestamptz(6)
  createdAt      DateTime    @default(now()) @db.Timestamp(6)
  updatedAt      DateTime    @default(now()) @updatedAt @db.Timestamp(6)

  user                User                 @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  coupon              Coupon?              @relation(fields: [couponId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  orderItems          OrderItem[]
  payments            Payment[]
  loyaltyTransactions LoyaltyTransaction[]
  statusHistory       OrderStatusHistory[]

  @@index([userId, createdAt], map: "idx_orders_user_created")
  @@index([status], map: "idx_orders_status")
  @@index([couponId], map: "idx_orders_coupon")
  @@map("orders")
}

model OrderItem {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId   String  @db.Uuid
  productId String  @db.Uuid
  size      Size
  qty       Int
  unitPrice Decimal @db.Decimal(12, 2)
  lineTotal Decimal @db.Decimal(12, 2)

  order    Order              @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  product  Product            @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  toppings OrderItemTopping[]

  @@index([orderId], map: "idx_order_items_order")
  @@index([productId], map: "idx_order_items_product")
  @@map("order_items")
}

model OrderItemTopping {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderItemId String  @db.Uuid
  toppingId   String  @db.Uuid
  price       Decimal @db.Decimal(12, 2)

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  topping   Topping   @relation(fields: [toppingId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([orderItemId, toppingId], map: "uq_order_item_topping")
  @@index([orderItemId], map: "idx_oit_order_item")
  @@map("order_item_toppings")
}

model Payment {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId        String        @db.Uuid
  idempotencyKey String        @unique @db.VarChar(128)
  amount         Decimal       @db.Decimal(12, 2)
  method         PaymentMethod
  status         PaymentStatus
  providerRef    String?       @db.VarChar(255)
  createdAt      DateTime      @default(now()) @db.Timestamp(6)

  order Order @relation(fields: [orderId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([orderId], map: "idx_payments_order")
  @@map("payments")
}

model LoyaltyTransaction {
  id        String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String      @db.Uuid
  orderId   String?     @db.Uuid
  points    Int
  type      LoyaltyType
  createdAt DateTime    @default(now()) @db.Timestamp(6)

  user  User   @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  order Order? @relation(fields: [orderId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([userId], map: "idx_loyalty_user")
  @@map("loyalty_transactions")
}

model OrderStatusHistory {
  id         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId    String       @db.Uuid
  fromStatus OrderStatus?
  toStatus   OrderStatus
  changedAt  DateTime     @default(now()) @db.Timestamp(6)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([orderId], map: "idx_status_history_order")
  @@map("order_status_history")
}
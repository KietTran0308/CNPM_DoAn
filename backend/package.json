{
  "name": "brewlite-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "prebuild": "prisma generate --schema=prisma/schema.prisma",
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "prisma:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "echo \"Du lieu mau: import prisma/dbBrewLite.sql vao database moi; KHONG chay len DB da co du lieu\"",
    "test": "jest --runInBand",
    "test:integration": "node -e \"if (!process.env.TEST_DATABASE_URL) { console.error('Can khai bao TEST_DATABASE_URL tro den brewlite_test'); process.exit(1) }\" && jest --runInBand --testPathPattern=integration",
    "smoke": "node scripts/smoke.mjs",
    "lint": "tsc --noEmit",
    "test:e2e": "node scripts/e2e.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.4.15",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.4.7",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/testing": "^10.4.15",
    "@types/bcryptjs": "^2.4.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.0",
    "@types/supertest": "^7.2.1",
    "jest": "^29.7.0",
    "prisma": "^5.22.0",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/*.spec.ts"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/test/"
    ]
  }
}

# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Cấu hình Cơ sở dữ liệu SQL (Tùy chọn PostgreSQL; tự động dùng SQLite nhúng nếu chưa cấu hình)
# DATABASE_URL="postgresql://postgres:password@localhost:5432/brewlite"
# Hoặc từng biến độc lập:
# SQL_HOST="localhost"
# SQL_PORT="5432"
# SQL_DB_NAME="brewlite"
# SQL_USER="postgres"
# SQL_PASSWORD="your_password"

# Khóa bí mật ký JWT phiên đăng nhập
JWT_SECRET="brewlite_jwt_super_secret_key_2026"
